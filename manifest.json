{
  "manifest_version": 2,
  "name": "Discord Web Client",
  "version": "0.2.0",
  "description": "A chrome-free Discord wrapper that sends non-Discord URLs to the normal browser.",
  "permissions": ["nativeMessaging", "tabs", "downloads"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://discord.com/*", "https://discordapp.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "browser_specific_settings": {
    "gecko": { "id": "discord-client@localhost", "strict_min_version": "60.0" }
  }
}
